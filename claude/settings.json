{
  "alwaysThinkingEnabled": true,
  "autoCompactEnabled": true,
  "editorMode": "normal",
  "enableWorkflows": true,
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "teammateMode": "tmux"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/slurm-bootstrap.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/slurm-mountcheck.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/rocprofiler-compute-precommit.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/grill-me-gate.sh",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode|Skill"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/rocprofiler-compute-venv.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "bash '/home/abchoudh/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/grill-me-reset.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "showThinkingSummaries": false,
  "skipDangerousModePermissionPrompt": true,
  "speed": "fast",
  "statusLine": {
    "command": "~/.claude/claude-statusline",
    "type": "command"
  },
  "theme": "custom:snazzy-light",
  "ultracode": true,
  "voice": {
    "enabled": true,
    "mode": "tap"
  }
}